# ============================================================
# GitHub Analytics Data Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# -----------------------------------------------------------
# GitHub API
# -----------------------------------------------------------
# Create a Personal Access Token at:
#   https://github.com/settings/tokens
# Required scopes: repo (read), read:user
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Comma-separated list of GitHub usernames whose repos to analyze
# Leave empty to analyze the authenticated user's repos
GITHUB_USERNAMES=

# Maximum number of repos to fetch per user (0 = all)
MAX_REPOS_PER_USER=50

# -----------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Bucket (will be created during setup)
S3_BUCKET_NAME=github-analytics-data-lake

# -----------------------------------------------------------
# RDS PostgreSQL (Gold Layer)
# -----------------------------------------------------------
RDS_HOST=your-rds-instance.xxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=github_analytics
RDS_USERNAME=admin
RDS_PASSWORD=your_secure_password_here

# Constructed database URL (used by FastAPI/SQLAlchemy)
DATABASE_URL=postgresql://${RDS_USERNAME}:${RDS_PASSWORD}@${RDS_HOST}:${RDS_PORT}/${RDS_DATABASE}

# -----------------------------------------------------------
# FastAPI Backend
# -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# -----------------------------------------------------------
# Next.js Dashboard
# -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------
# AWS Glue
# -----------------------------------------------------------
GLUE_IAM_ROLE=arn:aws:iam::role/GlueServiceRole
GLUE_DATABASE_NAME=github_analytics_catalog
